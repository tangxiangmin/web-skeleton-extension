{
  "manifest_version": 3,
  "name": "web-skeleton",
  "version": "2.0",
  "description": "create web skeleton in first screen",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/content.js"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "notifications"
  ],
  "action": {
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png"
    },
    "default_popup": "src/popup.html"
  }
}
