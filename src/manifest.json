{
  "manifest_version": 3,
  "name": "web-skeleton",
  "version": "1.2",
  "description": "create web skeleton in first screen",
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/content.js"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "notifications"
  ],
  "action": {
    "default_popup": "src/popup.html"
  }
}
